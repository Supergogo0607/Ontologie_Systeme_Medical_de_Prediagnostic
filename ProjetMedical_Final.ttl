@prefix : <http://www.semanticweb.org/medical-decision-support#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/medical-decision-support#> .

<http://www.semanticweb.org/medical-decision-support> rdf:type owl:Ontology ;
                                                       rdfs:comment "Ontology for medical diagnosis decision support system - Sorbonne University Project"@en ;
                                                       rdfs:label "Medical Decision Support Ontology"@en .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/medical-decision-support#hasOnsetType
:hasOnsetType rdf:type owl:ObjectProperty ;
              rdfs:domain :Symptom ;
              rdfs:range :SymptomOnset ;
              rdfs:label "has onset type"@en .


###  http://www.semanticweb.org/medical-decision-support#hasPainType
:hasPainType rdf:type owl:ObjectProperty ;
             rdfs:domain :Symptom ;
             rdfs:range :PainCharacter ;
             rdfs:label "has pain type"@en .


###  http://www.semanticweb.org/medical-decision-support#hasSeverityLevel
:hasSeverityLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :Symptom ;
                  rdfs:range :SymptomSeverity ;
                  rdfs:label "has severity level"@en .


###  http://www.semanticweb.org/medical-decision-support#hasSymptom
:hasSymptom rdf:type owl:ObjectProperty ;
            owl:inverseOf :isSymptomOf ;
            rdfs:domain :Patient ;
            rdfs:range :Symptom ;
            rdfs:label "has symptom"@en .


###  http://www.semanticweb.org/medical-decision-support#indicatesDisease
:indicatesDisease rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isIndicatedBy ;
                  rdfs:domain :Symptom ;
                  rdfs:range :Disease ;
                  rdfs:label "indicates disease"@en .


###  http://www.semanticweb.org/medical-decision-support#isAssociatedWithSystem
:isAssociatedWithSystem rdf:type owl:ObjectProperty ;
                        rdfs:domain :Symptom ;
                        rdfs:range :BodySystem ;
                        rdfs:label "is associated with system"@en .


###  http://www.semanticweb.org/medical-decision-support#isIndicatedBy
:isIndicatedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Disease ;
               rdfs:range :Symptom ;
               rdfs:label "is indicated by"@en .


###  http://www.semanticweb.org/medical-decision-support#isSymptomOf
:isSymptomOf rdf:type owl:ObjectProperty ;
             rdfs:domain :Symptom ;
             rdfs:range :Patient ;
             rdfs:label "is symptom of"@en .


###  http://www.semanticweb.org/medical-decision-support#isTreatedByDepartment
:isTreatedByDepartment rdf:type owl:ObjectProperty ;
                       owl:inverseOf :treatsDisease ;
                       rdfs:domain :Disease ;
                       rdfs:range :MedicalDepartment ;
                       rdfs:label "is treated by department"@en .


###  http://www.semanticweb.org/medical-decision-support#possibleDisease
:possibleDisease rdf:type owl:ObjectProperty ;
                 rdfs:domain :Patient ;
                 rdfs:range :Disease ;
                 owl:propertyChainAxiom ( :hasSymptom
                                          :indicatesDisease
                                        ) ;
                 rdfs:comment "Inferred: Patient -> Symptom -> Disease"@en ;
                 rdfs:label "possible disease"@en .


###  http://www.semanticweb.org/medical-decision-support#recommendedDepartment
:recommendedDepartment rdf:type owl:ObjectProperty ;
                       rdfs:domain :Patient ;
                       rdfs:range :MedicalDepartment ;
                       owl:propertyChainAxiom ( :possibleDisease
                                                :isTreatedByDepartment
                                              ) ;
                       rdfs:comment "Inferred: Patient -> Disease -> Department"@en ;
                       rdfs:label "recommended department"@en .


###  http://www.semanticweb.org/medical-decision-support#recommendedDrugFor
:recommendedDrugFor rdf:type owl:ObjectProperty ;
                    owl:inverseOf :treatsCondition ;
                    rdfs:domain :Drug ;
                    rdfs:range :Disease ;
                    rdfs:label "recommended drug for"@en .


###  http://www.semanticweb.org/medical-decision-support#treatsCondition
:treatsCondition rdf:type owl:ObjectProperty ;
                 rdfs:domain :Disease ;
                 rdfs:range :Drug ;
                 rdfs:label "treats condition"@en .


###  http://www.semanticweb.org/medical-decision-support#treatsDisease
:treatsDisease rdf:type owl:ObjectProperty ;
               rdfs:domain :MedicalDepartment ;
               rdfs:range :Disease ;
               rdfs:label "treats disease"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/medical-decision-support#hasCertaintyScore
:hasCertaintyScore rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:float ;
                   rdfs:label "has certainty score"@en .


###  http://www.semanticweb.org/medical-decision-support#hasDuration
:hasDuration rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:integer ;
             rdfs:label "has duration (days)"@en .


###  http://www.semanticweb.org/medical-decision-support#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:integer ;
            rdfs:label "patient age"@en .


###  http://www.semanticweb.org/medical-decision-support#patientName
:patientName rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string ;
             rdfs:label "patient name"@en .


###  http://www.semanticweb.org/medical-decision-support#symptomDescription
:symptomDescription rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:string ;
                    rdfs:label "symptom description"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/medical-decision-support#AbdominalPain
:AbdominalPain rdf:type owl:Class ;
               rdfs:subClassOf :DigestiveSymptom .


###  http://www.semanticweb.org/medical-decision-support#Analgesic
:Analgesic rdf:type owl:Class ;
           rdfs:subClassOf :Drug .


###  http://www.semanticweb.org/medical-decision-support#AnginaPectoris
:AnginaPectoris rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :CardiovascularDisease
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isIndicatedBy ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( :ChestPain
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty :hasPainType ;
                                                                                                         owl:hasValue :pain_Pressure
                                                                                                       ]
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty :hasSeverityLevel ;
                                                                                                         owl:hasValue :sev_Severe
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isIndicatedBy ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( :ShortnessOfBreath
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty :hasSeverityLevel ;
                                                                                                         owl:hasValue :sev_Moderate
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :isTreatedByDepartment ;
                                                             owl:hasValue :dept_Cardiology
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :CardiovascularDisease ;
                rdfs:label "Angina Pectoris"@en .


###  http://www.semanticweb.org/medical-decision-support#Antacid
:Antacid rdf:type owl:Class ;
         rdfs:subClassOf :Drug .


###  http://www.semanticweb.org/medical-decision-support#Antibiotic
:Antibiotic rdf:type owl:Class ;
            rdfs:subClassOf :Drug .


###  http://www.semanticweb.org/medical-decision-support#Antidiarrheal
:Antidiarrheal rdf:type owl:Class ;
               rdfs:subClassOf :Drug ;
               rdfs:label "Antidiarrheal"@en .


###  http://www.semanticweb.org/medical-decision-support#Antiplatelet
:Antiplatelet rdf:type owl:Class ;
              rdfs:subClassOf :Drug .


###  http://www.semanticweb.org/medical-decision-support#Antitussive
:Antitussive rdf:type owl:Class ;
             rdfs:subClassOf :Drug .


###  http://www.semanticweb.org/medical-decision-support#BodySystem
:BodySystem rdf:type owl:Class ;
            rdfs:label "Body System"@en .


###  http://www.semanticweb.org/medical-decision-support#Cardiology
:Cardiology rdf:type owl:Class ;
            rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#CardiovascularDisease
:CardiovascularDisease rdf:type owl:Class ;
                       rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/medical-decision-support#CardiovascularSymptom
:CardiovascularSymptom rdf:type owl:Class ;
                       rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#CardiovascularSystem
:CardiovascularSystem rdf:type owl:Class ;
                      rdfs:subClassOf :BodySystem .


###  http://www.semanticweb.org/medical-decision-support#ChestPain
:ChestPain rdf:type owl:Class ;
           rdfs:subClassOf :CardiovascularSymptom .


###  http://www.semanticweb.org/medical-decision-support#CommonCold
:CommonCold rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :RespiratoryDisease
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :isIndicatedBy ;
                                                         owl:someValuesFrom :Rhinorrhea
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :isIndicatedBy ;
                                                         owl:someValuesFrom :Sneezing
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :isTreatedByDepartment ;
                                                         owl:hasValue :dept_GeneralPractice
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :RespiratoryDisease ;
            rdfs:label "Common Cold"@en .


###  http://www.semanticweb.org/medical-decision-support#Cough
:Cough rdf:type owl:Class ;
       rdfs:subClassOf :RespiratorySymptom .


###  http://www.semanticweb.org/medical-decision-support#Cystitis
:Cystitis rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :OtherDisease
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :isIndicatedBy ;
                                                       owl:someValuesFrom :Dysuria
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :isIndicatedBy ;
                                                       owl:someValuesFrom :Frequency
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :isTreatedByDepartment ;
                                                       owl:hasValue :dept_Urology
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :OtherDisease ;
          rdfs:label "Cystitis"@en .


###  http://www.semanticweb.org/medical-decision-support#Dermatology
:Dermatology rdf:type owl:Class ;
             rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#Diarrhea
:Diarrhea rdf:type owl:Class ;
          rdfs:subClassOf :DigestiveSymptom .


###  http://www.semanticweb.org/medical-decision-support#DigestiveDisease
:DigestiveDisease rdf:type owl:Class ;
                  rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/medical-decision-support#DigestiveSymptom
:DigestiveSymptom rdf:type owl:Class ;
                  rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#DigestiveSystem
:DigestiveSystem rdf:type owl:Class ;
                 rdfs:subClassOf :BodySystem .


###  http://www.semanticweb.org/medical-decision-support#Disease
:Disease rdf:type owl:Class ;
         rdfs:label "Disease"@en .


###  http://www.semanticweb.org/medical-decision-support#Dizziness
:Dizziness rdf:type owl:Class ;
           rdfs:subClassOf :NeurologicalSymptom .


###  http://www.semanticweb.org/medical-decision-support#Drug
:Drug rdf:type owl:Class ;
      rdfs:label "Drug"@en .


###  http://www.semanticweb.org/medical-decision-support#Dysuria
:Dysuria rdf:type owl:Class ;
         rdfs:subClassOf :UrinarySymptom .


###  http://www.semanticweb.org/medical-decision-support#Emergency
:Emergency rdf:type owl:Class ;
           rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#Fatigue
:Fatigue rdf:type owl:Class ;
         rdfs:subClassOf :GeneralSymptom .


###  http://www.semanticweb.org/medical-decision-support#Fever
:Fever rdf:type owl:Class ;
       rdfs:subClassOf :GeneralSymptom .


###  http://www.semanticweb.org/medical-decision-support#Frequency
:Frequency rdf:type owl:Class ;
           rdfs:subClassOf :UrinarySymptom .


###  http://www.semanticweb.org/medical-decision-support#Gastritis
:Gastritis rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :DigestiveDisease
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isIndicatedBy ;
                                                        owl:someValuesFrom :Vomiting
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isIndicatedBy ;
                                                        owl:someValuesFrom [ owl:intersectionOf ( :AbdominalPain
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty :hasPainType ;
                                                                                                    owl:hasValue :pain_Burning
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isTreatedByDepartment ;
                                                        owl:hasValue :dept_Gastroenterology
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :DigestiveDisease ;
           rdfs:label "Gastritis"@en .


###  http://www.semanticweb.org/medical-decision-support#Gastroenteritis
:Gastroenteritis rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :DigestiveDisease
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isIndicatedBy ;
                                                              owl:someValuesFrom :AbdominalPain
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isIndicatedBy ;
                                                              owl:someValuesFrom :Diarrhea
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isIndicatedBy ;
                                                              owl:someValuesFrom :Vomiting
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :isTreatedByDepartment ;
                                                              owl:hasValue :dept_Gastroenterology
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :DigestiveDisease ;
                 rdfs:label "Gastroenteritis"@en .


###  http://www.semanticweb.org/medical-decision-support#Gastroenterology
:Gastroenterology rdf:type owl:Class ;
                  rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#GeneralPractice
:GeneralPractice rdf:type owl:Class ;
                 rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#GeneralSymptom
:GeneralSymptom rdf:type owl:Class ;
                rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#Headache
:Headache rdf:type owl:Class ;
          rdfs:subClassOf :NeurologicalSymptom .


###  http://www.semanticweb.org/medical-decision-support#Influenza
:Influenza rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :RespiratoryDisease
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isIndicatedBy ;
                                                        owl:someValuesFrom :Fatigue
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isIndicatedBy ;
                                                        owl:someValuesFrom [ owl:intersectionOf ( :Cough
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty :hasDuration ;
                                                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                         owl:onDatatype xsd:integer ;
                                                                                                                         owl:withRestrictions ( [ xsd:minInclusive 3
                                                                                                                                                ]
                                                                                                                                              )
                                                                                                                       ]
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isIndicatedBy ;
                                                        owl:someValuesFrom [ owl:intersectionOf ( :Fever
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty :hasSeverityLevel ;
                                                                                                    owl:hasValue :sev_Moderate
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isTreatedByDepartment ;
                                                        owl:hasValue :dept_GeneralPractice
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :RespiratoryDisease ;
           rdfs:label "Influenza"@en .


###  http://www.semanticweb.org/medical-decision-support#MedicalDepartment
:MedicalDepartment rdf:type owl:Class ;
                   rdfs:label "Medical Department"@en .


###  http://www.semanticweb.org/medical-decision-support#MyocardialInfarction
:MyocardialInfarction rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :CardiovascularDisease
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :isIndicatedBy ;
                                                                   owl:someValuesFrom :Sweating
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :isIndicatedBy ;
                                                                   owl:someValuesFrom [ owl:intersectionOf ( :ChestPain
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty :hasPainType ;
                                                                                                               owl:hasValue :pain_Pressure
                                                                                                             ]
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty :hasSeverityLevel ;
                                                                                                               owl:hasValue :sev_Severe
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdf:type owl:Class
                                                                                      ]
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :isIndicatedBy ;
                                                                   owl:someValuesFrom [ owl:intersectionOf ( :ShortnessOfBreath
                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty :hasSeverityLevel ;
                                                                                                               owl:hasValue :sev_Severe
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdf:type owl:Class
                                                                                      ]
                                                                 ]
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :isTreatedByDepartment ;
                                                                   owl:hasValue :dept_Emergency
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :CardiovascularDisease ;
                      rdfs:label "Myocardial Infarction"@en .


###  http://www.semanticweb.org/medical-decision-support#NervousSystem
:NervousSystem rdf:type owl:Class ;
               rdfs:subClassOf :BodySystem .


###  http://www.semanticweb.org/medical-decision-support#NeurologicalSymptom
:NeurologicalSymptom rdf:type owl:Class ;
                     rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#OtherDisease
:OtherDisease rdf:type owl:Class ;
              rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/medical-decision-support#PainCharacter
:PainCharacter rdf:type owl:Class ;
               rdfs:subClassOf :SymptomAttribute .


###  http://www.semanticweb.org/medical-decision-support#Palpitation
:Palpitation rdf:type owl:Class ;
             rdfs:subClassOf :CardiovascularSymptom .


###  http://www.semanticweb.org/medical-decision-support#Patient
:Patient rdf:type owl:Class ;
         rdfs:label "Patient"@en .


###  http://www.semanticweb.org/medical-decision-support#RespiratoryDisease
:RespiratoryDisease rdf:type owl:Class ;
                    rdfs:subClassOf :Disease .


###  http://www.semanticweb.org/medical-decision-support#RespiratoryMedicine
:RespiratoryMedicine rdf:type owl:Class ;
                     rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#RespiratorySymptom
:RespiratorySymptom rdf:type owl:Class ;
                    rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#RespiratorySystem
:RespiratorySystem rdf:type owl:Class ;
                   rdfs:subClassOf :BodySystem .


###  http://www.semanticweb.org/medical-decision-support#Rhinorrhea
:Rhinorrhea rdf:type owl:Class ;
            rdfs:subClassOf :RespiratorySymptom .


###  http://www.semanticweb.org/medical-decision-support#SevereSymptom
:SevereSymptom rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Symptom
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasSeverityLevel ;
                                                            owl:hasValue :sev_Severe
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:label "Severe Symptom"@en .


###  http://www.semanticweb.org/medical-decision-support#ShortnessOfBreath
:ShortnessOfBreath rdf:type owl:Class ;
                   rdfs:subClassOf :CardiovascularSymptom .


###  http://www.semanticweb.org/medical-decision-support#Sneezing
:Sneezing rdf:type owl:Class ;
          rdfs:subClassOf :RespiratorySymptom .


###  http://www.semanticweb.org/medical-decision-support#Sweating
:Sweating rdf:type owl:Class ;
          rdfs:subClassOf :GeneralSymptom .


###  http://www.semanticweb.org/medical-decision-support#Symptom
:Symptom rdf:type owl:Class ;
         rdfs:label "Symptom"@en .


###  http://www.semanticweb.org/medical-decision-support#SymptomAttribute
:SymptomAttribute rdf:type owl:Class ;
                  rdfs:label "Symptom Attribute"@en .


###  http://www.semanticweb.org/medical-decision-support#SymptomOnset
:SymptomOnset rdf:type owl:Class ;
              rdfs:subClassOf :SymptomAttribute .


###  http://www.semanticweb.org/medical-decision-support#SymptomSeverity
:SymptomSeverity rdf:type owl:Class ;
                 rdfs:subClassOf :SymptomAttribute .


###  http://www.semanticweb.org/medical-decision-support#Urgency
:Urgency rdf:type owl:Class ;
         rdfs:subClassOf :UrinarySymptom .


###  http://www.semanticweb.org/medical-decision-support#UrinarySymptom
:UrinarySymptom rdf:type owl:Class ;
                rdfs:subClassOf :Symptom .


###  http://www.semanticweb.org/medical-decision-support#UrinarySystem
:UrinarySystem rdf:type owl:Class ;
               rdfs:subClassOf :BodySystem .


###  http://www.semanticweb.org/medical-decision-support#Urology
:Urology rdf:type owl:Class ;
         rdfs:subClassOf :MedicalDepartment .


###  http://www.semanticweb.org/medical-decision-support#Vomiting
:Vomiting rdf:type owl:Class ;
          rdfs:subClassOf :DigestiveSymptom .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/medical-decision-support#dept_Cardiology
:dept_Cardiology rdf:type owl:NamedIndividual ,
                          :Cardiology .


###  http://www.semanticweb.org/medical-decision-support#dept_Dermatology
:dept_Dermatology rdf:type owl:NamedIndividual ,
                           :Dermatology .


###  http://www.semanticweb.org/medical-decision-support#dept_Emergency
:dept_Emergency rdf:type owl:NamedIndividual ,
                         :Emergency .


###  http://www.semanticweb.org/medical-decision-support#dept_Gastroenterology
:dept_Gastroenterology rdf:type owl:NamedIndividual ,
                                :Gastroenterology .


###  http://www.semanticweb.org/medical-decision-support#dept_GeneralPractice
